# Application
ENVIRONMENT=development
DEBUG=false

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Public frontend base URL used for email confirmation and password reset redirects.
# Production example: https://app.fincruiz.com
AUTH_FRONTEND_URL=http://localhost:3000

# Add any AI provider key used by your AI CFO service here.
# Never commit real secrets to source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# P6 integrations
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_FRONTEND_URL=http://localhost:3000
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/xero/callback
# Enable only after the Xero app is approved for accounting.journals.read (Advanced/certified access).
XERO_JOURNALS_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/zoho/callback
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3

# Commercial billing (server-side only)
BILLING_FRONTEND_URL=http://localhost:3000
# Keep false until Stage 10 production certification is deliberately complete.
BILLING_ALLOW_LIVE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_MONTHLY_PLAN_ID=
RAZORPAY_STARTER_ANNUAL_PLAN_ID=
RAZORPAY_GROWTH_MONTHLY_PLAN_ID=
RAZORPAY_GROWTH_ANNUAL_PLAN_ID=

# Paid-launch operator evidence. Set timestamps only after the named check passed.
PAID_LAUNCH_PROVIDERS=stripe,razorpay
DEPLOYMENT_REGION=
DATABASE_REGION=
PRODUCTION_PERFORMANCE_CERTIFIED_AT=
STRIPE_SANDBOX_CERTIFIED_AT=
RAZORPAY_SANDBOX_CERTIFIED_AT=
BACKUP_RESTORE_VERIFIED_AT=
LAUNCH_CERTIFICATION_MAX_AGE_DAYS=30
BACKUP_RESTORE_MAX_AGE_DAYS=90
ERROR_MONITORING_DSN=
ERROR_MONITORING_VERIFIED_AT=
SUPPORT_CONTACT_EMAIL=
SUPPORT_RUNBOOK_URL=
# Point imports at persistent production storage and turn this on only after verification.
IMPORT_STAGING_DIR=uploads/staging
IMPORT_STAGING_PERSISTENT=false
